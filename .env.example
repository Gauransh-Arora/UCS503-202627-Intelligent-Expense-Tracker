# Database URL (PostgreSQL or SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# JWT Authentication
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# Default Currency & Locale
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en_IN

# OCR Settings (paddleocr / tesseract)
OCR_PROVIDER=paddleocr
OCR_CONFIDENCE_THRESHOLD=0.60

# Recurring Detection Tolerances
RECURRING_AMOUNT_TOLERANCE_PCT=0.15
RECURRING_INTERVAL_TOLERANCE_DAYS=4

# Unusual Spending Detection (Mean ± k*σ or Median/MAD)
UNUSUAL_SPENDING_SENSITIVITY_K=2.0
MIN_HISTORY_MONTHS_FOR_ANOMALY=2
MIN_TRANSACTIONS_FOR_ANOMALY=5

# Wishlist & Purchase Readiness Ratios
READINESS_COMFORTABLE_RATIO=1.0
READINESS_POSSIBLE_RATIO=2.5

# Bank Statement Duplicate Detection Tolerances
DUPLICATE_AMOUNT_TOLERANCE=0.01
DUPLICATE_DATE_TOLERANCE_DAYS=2
